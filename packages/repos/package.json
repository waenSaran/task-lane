{
  "name": "@task-lane/repos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./src/index.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm build && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm --filter @task-lane/domain build && pnpm --filter @task-lane/db build && pnpm build && node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@task-lane/db": "workspace:*",
    "@task-lane/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "5.9.2"
  },
  "types": "./src/index.ts"
}

{
  "name": "@task-lane/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node build",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lucide/svelte": "1.45.0",
    "@task-lane/db": "workspace:*",
    "@task-lane/domain": "workspace:*",
    "@task-lane/plane": "workspace:*",
    "@task-lane/repos": "workspace:*",
    "bits-ui": "2.19.2",
    "clsx": "2.1.1",
    "pg": "8.23.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
